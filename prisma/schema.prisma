generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

enum SessionStatus {
  ACTIVE
  CLOSED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  LEAVE
}

model Teacher {
  id           Int              @id @default(autoincrement()) @db.UnsignedInt
  email        String           @unique @db.VarChar(255)
  fullName     String           @map("full_name") @db.VarChar(150)
  passwordHash String           @map("password_hash") @db.VarChar(180)
  createdAt    DateTime         @default(now()) @map("created_at")
  teacherCode  String?          @map("teacher_code") @db.VarChar(30)
  department   String?          @db.VarChar(100)
  phone        String?          @db.VarChar(30)
  profileImage Bytes?           @map("profile_image") @db.MediumBlob
  profileImageMime String?      @map("profile_image_mime") @db.VarChar(50)
  status       AccountStatus    @default(ACTIVE)
  subjects     Subject[]
  sessions     CheckInSession[]
  notifications TeacherNotification[]

  @@map("teachers")
}

model Student {
  id           Int                @id @default(autoincrement()) @db.UnsignedInt
  email        String             @unique @db.VarChar(255)
  fullName     String             @map("full_name") @db.VarChar(150)
  studentCode  String             @unique @map("student_code") @db.VarChar(50)
  passwordHash String             @map("password_hash") @db.VarChar(180)
  createdAt    DateTime           @default(now()) @map("created_at")
  classId      Int?               @map("class_id") @db.UnsignedInt
  classNumber  Int?               @map("class_number") @db.UnsignedInt
  phone        String?            @db.VarChar(30)
  parentName   String?            @map("parent_name") @db.VarChar(150)
  status       AccountStatus      @default(ACTIVE)
  classroom    Classroom?         @relation(fields: [classId], references: [id])
  attendance   AttendanceRecord[]

  @@map("students")
}

model Classroom {
  id               Int              @id @default(autoincrement()) @db.UnsignedInt
  name             String           @unique @db.VarChar(50)
  level            String           @db.VarChar(30)
  advisorTeacherId Int?             @map("advisor_teacher_id") @db.UnsignedInt
  createdAt        DateTime         @default(now()) @map("created_at")
  students         Student[]
  subjects         Subject[]
  sessions         CheckInSession[]
  schedules        Schedule[]

  @@index([advisorTeacherId], map: "idx_classroom_advisor")
  @@map("classrooms")
}

model Subject {
  id             Int                @id @default(autoincrement()) @db.UnsignedInt
  subjectCode    String             @unique @map("subject_code") @db.VarChar(30)
  subjectName    String             @map("subject_name") @db.VarChar(200)
  teacherId      Int?               @map("teacher_id") @db.UnsignedInt
  classroomId    Int?               @map("classroom_id") @db.UnsignedInt
  createdAt      DateTime           @default(now()) @map("created_at")
  gradeLevel     String?            @map("grade_level") @db.VarChar(10)
  semester       Int                @default(1) @db.UnsignedTinyInt
  academicYear   String             @default("2569") @map("academic_year") @db.VarChar(10)
  credits        Decimal            @default(1.0) @db.Decimal(3, 1)
  studyDays      String?            @map("study_days") @db.VarChar(100)
  startTime      DateTime?          @map("start_time") @db.Time(0)
  endTime        DateTime?          @map("end_time") @db.Time(0)
  location       String?            @db.VarChar(150)
  attendanceMode String             @default("EVERY_PERIOD") @map("attendance_mode") @db.VarChar(20)
  isActive       Boolean            @default(true) @map("is_active")
  description    String?            @db.VarChar(255)
  teacher        Teacher?           @relation(fields: [teacherId], references: [id])
  classroom      Classroom?         @relation(fields: [classroomId], references: [id])
  sessions       CheckInSession[]
  schedules      Schedule[]
  attendance     AttendanceRecord[]

  @@index([teacherId], map: "idx_subject_teacher")
  @@index([classroomId], map: "idx_subject_classroom")
  @@map("subjects")
}

model Schedule {
  id          Int              @id @default(autoincrement()) @db.UnsignedInt
  subjectId   Int              @map("subject_id") @db.UnsignedInt
  classroomId Int              @map("classroom_id") @db.UnsignedInt
  dayOfWeek   Int              @map("day_of_week") @db.UnsignedTinyInt
  periodName  String?          @map("period_name") @db.VarChar(50)
  startTime   DateTime         @map("start_time") @db.Time(0)
  endTime     DateTime         @map("end_time") @db.Time(0)
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at")
  subject     Subject          @relation(fields: [subjectId], references: [id])
  classroom   Classroom        @relation(fields: [classroomId], references: [id])
  sessions    CheckInSession[]

  @@unique([subjectId, dayOfWeek, startTime], map: "uq_schedule_subject_day_start")
  @@index([classroomId, dayOfWeek], map: "idx_schedule_classroom_day")
  @@map("schedules")
}

model CheckInSession {
  id                 BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  subjectId          Int                @map("subject_id") @db.UnsignedInt
  classroomId        Int                @map("classroom_id") @db.UnsignedInt
  sessionDate        DateTime           @map("session_date") @db.Date
  startTime          DateTime           @map("start_time") @db.Time(0)
  endTime            DateTime           @map("end_time") @db.Time(0)
  lateAfter          DateTime           @map("late_after") @db.Time(0)
  status             SessionStatus      @default(ACTIVE)
  createdByAdminId   Int?               @map("created_by_admin_id") @db.UnsignedInt
  createdByTeacherId Int?               @map("created_by_teacher_id") @db.UnsignedInt
  createdAt          DateTime           @default(now()) @map("created_at")
  scheduleId         Int?               @map("schedule_id") @db.UnsignedInt
  subject            Subject            @relation(fields: [subjectId], references: [id])
  classroom          Classroom          @relation(fields: [classroomId], references: [id])
  schedule           Schedule?          @relation(fields: [scheduleId], references: [id])
  teacher            Teacher?           @relation(fields: [createdByTeacherId], references: [id])
  attendance         AttendanceRecord[]

  @@unique([subjectId, sessionDate, startTime], map: "uq_check_in_session_round")
  @@index([sessionDate], map: "idx_check_in_session_date")
  @@index([subjectId], map: "idx_check_in_session_subject")
  @@index([createdByTeacherId], map: "idx_check_in_session_teacher")
  @@index([scheduleId], map: "idx_check_in_session_schedule")
  @@map("check_in_sessions")
}

model AttendanceRecord {
  id               BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  studentId        Int              @map("student_id") @db.UnsignedInt
  subjectId        Int?             @map("subject_id") @db.UnsignedInt
  attendanceDate   DateTime         @map("attendance_date") @db.Date
  checkInTime      DateTime?        @map("check_in_time") @db.DateTime(0)
  status           AttendanceStatus
  confidence       Decimal?         @db.Decimal(5, 2)
  createdAt        DateTime         @default(now()) @map("created_at")
  checkInSessionId BigInt?          @map("check_in_session_id") @db.UnsignedBigInt
  student          Student          @relation(fields: [studentId], references: [id])
  subject          Subject?         @relation(fields: [subjectId], references: [id])
  session          CheckInSession?  @relation(fields: [checkInSessionId], references: [id])

  @@unique([studentId, checkInSessionId], map: "uq_attendance_student_session")
  @@index([subjectId, attendanceDate], map: "idx_attendance_subject_date")
  @@index([attendanceDate], map: "idx_attendance_date")
  @@index([studentId], map: "idx_attendance_student")
  @@index([checkInSessionId], map: "idx_attendance_session")
  @@map("attendance_records")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement()) @map("log_id") @db.UnsignedBigInt
  userId      Int      @map("user_id") @db.UnsignedInt
  action      String   @db.VarChar(50)
  entity      String   @db.VarChar(50)
  entityId    String?  @map("entity_id") @db.VarChar(50)
  description String?  @db.Text
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt], map: "idx_audit_user_created")
  @@map("audit_logs")
}

model TeacherNotification {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  teacherId Int      @map("teacher_id") @db.UnsignedInt
  title     String   @db.VarChar(180)
  message   String   @db.VarChar(500)
  href      String?  @db.VarChar(255)
  type      String   @default("INFO") @db.VarChar(30)
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  teacher   Teacher  @relation(fields: [teacherId], references: [id])

  @@index([teacherId, isRead, createdAt], map: "idx_teacher_notification_read")
  @@map("teacher_notifications")
}
